<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="TransactionsSummaryReport" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    
    <parameter name="DATE_RANGE" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.lang.String"/>
    <parameter name="OUTLET_FILTER" class="java.lang.String"/>
    <parameter name="RESTAURANT_NAME" class="java.lang.String"/>

    <field name="date" class="java.lang.String"/>
    <field name="orderCount" class="java.lang.Long"/>
    <field name="totalRevenue" class="java.math.BigDecimal"/>
    <field name="averageOrderValue" class="java.math.BigDecimal"/>
    
    <variable name="totalOrderCount" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{orderCount}]]></variableExpression>
    </variable>
    
    <variable name="grandTotalRevenue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalRevenue}]]></variableExpression>
    </variable>

    <title>
        <band height="80">
            <rectangle>
                <reportElement mode="Opaque" x="-20" y="-20" width="595" height="85" backcolor="#27AE60"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="0" y="-10" width="555" height="26" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{RESTAURANT_NAME} != null ? $P{RESTAURANT_NAME} : "WildBar") + " Restaurant"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="16" width="555" height="18" forecolor="#ECF0F1"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Consolidated Sales Summary (Day-wise)]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="36" width="555" height="14" forecolor="#E8F8F5"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + ($P{DATE_RANGE} != null ? $P{DATE_RANGE} : "Custom Range") + "  |  Filter: " + ($P{OUTLET_FILTER} != null ? $P{OUTLET_FILTER} : "Consolidated") + "  |  Generated: " + ($P{GENERATED_AT} != null ? $P{GENERATED_AT} : "")]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <columnHeader>
        <band height="30">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="25" backcolor="#34495E"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5" y="0" width="195" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="100" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Total Orders]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="0" width="125" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Average Value]]></text>
            </staticText>
            <staticText>
                <reportElement x="425" y="0" width="125" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Total Revenue]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <detail>
        <band height="25">
            <textField>
                <reportElement x="5" y="0" width="195" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="0" width="100" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{orderCount}]]></textFieldExpression>
            </textField>
            <textField pattern="###0.00">
                <reportElement x="300" y="0" width="125" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{averageOrderValue}]]></textFieldExpression>
            </textField>
            <textField pattern="###0.00">
                <reportElement x="425" y="0" width="125" height="20" forecolor="#27AE60"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalRevenue}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="22" width="555" height="1" forecolor="#ECF0F1"/>
            </line>
        </band>
    </detail>
    
    <summary>
        <band height="40">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="10" width="555" height="30" backcolor="#2C3E50"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5" y="10" width="195" height="30" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[GRAND TOTAL]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="10" width="100" height="30" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalOrderCount}]]></textFieldExpression>
            </textField>
            <textField pattern="###0.00">
                <reportElement x="425" y="10" width="125" height="30" forecolor="#2ECC71"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{grandTotalRevenue}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
