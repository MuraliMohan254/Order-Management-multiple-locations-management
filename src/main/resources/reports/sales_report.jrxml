<jasperReport name="SalesReport"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <!-- Parameters passed from backend service -->
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="dateRangeText" class="java.lang.String"/>
    <parameter name="generatedAt" class="java.lang.String"/>
    <parameter name="totalRevenue" class="java.math.BigDecimal"/>
    <parameter name="totalOrders" class="java.lang.Long"/>
    <parameter name="dineInCount" class="java.lang.Long"/>
    <parameter name="takeAwayCount" class="java.lang.Long"/>

    <!-- Fields mapped from JRBeanCollectionDataSource (OrderReportItemDto) -->
    <field name="orderNumber" class="java.lang.String"/>
    <field name="orderType" class="java.lang.String"/>
    <field name="tableName" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="grandTotal" class="java.math.BigDecimal"/>
    <field name="createdAtText" class="java.lang.String"/>

    <!-- Title Section -->
    <title>
        <band height="110">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="100" backcolor="#0F172A"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            
            <staticText>
                <reportElement x="20" y="15" width="250" height="26" forecolor="#FFFFFF"/>
                <textElement>
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[WildBar Restaurant]]></text>
            </staticText>
            
            <textField>
                <reportElement x="20" y="42" width="280" height="18" forecolor="#94A3B8"/>
                <textElement>
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="20" y="65" width="300" height="15" forecolor="#64748B"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{dateRangeText}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="330" y="15" width="205" height="15" forecolor="#94A3B8"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{generatedAt}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="350" y="42" width="185" height="14" forecolor="#94A3B8"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Total Sales Revenue]]></text>
            </staticText>

            <textField pattern="¤#,##0.00">
                <reportElement x="350" y="58" width="185" height="24" forecolor="#38BDF8"/>
                <textElement textAlignment="Right">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalRevenue}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Page Header / KPI Summary Cards -->
    <pageHeader>
        <band height="45">
            <rectangle>
                <reportElement x="0" y="5" width="555" height="30" backcolor="#F8FAFC"/>
                <graphicElement>
                    <pen lineWidth="1" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>
            
            <textField>
                <reportElement x="15" y="12" width="160" height="16" forecolor="#1E293B"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Orders: " + $P{totalOrders}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="195" y="12" width="160" height="16" forecolor="#1E293B"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Dine-In: " + $P{dineInCount}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="375" y="12" width="165" height="16" forecolor="#1E293B"/>
                <textElement textAlignment="Right">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Takeaway: " + $P{takeAwayCount}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- Column Headers -->
    <columnHeader>
        <band height="28">
            <rectangle>
                <reportElement x="0" y="2" width="555" height="24" backcolor="#1E293B"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="10" y="7" width="110" height="14" forecolor="#FFFFFF"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ORDER NUMBER]]></text>
            </staticText>

            <staticText>
                <reportElement x="125" y="7" width="80" height="14" forecolor="#FFFFFF"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[CHANNEL]]></text>
            </staticText>

            <staticText>
                <reportElement x="210" y="7" width="70" height="14" forecolor="#FFFFFF"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[TABLE]]></text>
            </staticText>

            <staticText>
                <reportElement x="285" y="7" width="85" height="14" forecolor="#FFFFFF"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[STATUS]]></text>
            </staticText>

            <staticText>
                <reportElement x="375" y="7" width="95" height="14" forecolor="#FFFFFF"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[TIMESTAMP]]></text>
            </staticText>

            <staticText>
                <reportElement x="475" y="7" width="70" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[AMOUNT]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Details Section: Each Order Row -->
    <detail>
        <band height="22">
            <line>
                <reportElement x="0" y="21" width="555" height="1" forecolor="#F1F5F9"/>
            </line>

            <textField>
                <reportElement x="10" y="4" width="110" height="14" forecolor="#0F172A"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{orderNumber}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="125" y="4" width="80" height="14" forecolor="#334155"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{orderType}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="210" y="4" width="70" height="14" forecolor="#334155"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tableName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="285" y="4" width="85" height="14" forecolor="#2563EB"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="375" y="4" width="95" height="14" forecolor="#64748B"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{createdAtText}]]></textFieldExpression>
            </textField>

            <textField pattern="¤#,##0.00">
                <reportElement x="475" y="4" width="70" height="14" forecolor="#0F172A"/>
                <textElement textAlignment="Right">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{grandTotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="0" y="10" width="200" height="15" forecolor="#94A3B8"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["WildBar POS Management System"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="355" y="10" width="200" height="15" forecolor="#94A3B8"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary Section at End of Report -->
    <summary>
        <band height="60">
            <rectangle>
                <reportElement x="0" y="10" width="555" height="40" backcolor="#F1F5F9"/>
                <graphicElement>
                    <pen lineWidth="1" lineColor="#CBD5E1"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="15" y="20" width="250" height="18" forecolor="#0F172A"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORT SUMMARY & GRAND TOTAL]]></text>
            </staticText>

            <textField pattern="¤#,##0.00">
                <reportElement x="350" y="20" width="190" height="20" forecolor="#0F172A"/>
                <textElement textAlignment="Right">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalRevenue}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
