[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
C = IN
ST = Telangana
L = Hyderabad
O = OM
OU = IT
CN = OM.local

[v3_req]
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = OM.local
DNS.3 = *.OM.local
IP.1 = 127.0.0.1
